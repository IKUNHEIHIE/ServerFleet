    "/api/v1/nodes/{nodeId}/diagnostics": {
      "get": {
        "operationId": "readNodeConnectionDiagnosticsR37",
        "summary": "Read persistent bounded Agent diagnostics within current nodes.read scope",
        "description": "Latest heartbeat is separate; a historical handshake is not a current authorization proof. No extra history row per heartbeat, no global inventory leak.",
        "tags": [
          "IdentityOperationsR37"
        ],
        "security": [
          {
            "cookieSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Latest authenticated handshake and up to 100 connection events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "nodeId": {
                      "type": "string"
                    },
                    "connectionState": {
                      "type": "string",
                      "enum": [
                        "online",
                        "unreachable",
                        "identity_rejected",
                        "unknown"
                      ]
                    },
                    "lastHeartbeatAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "agentVersion": {
                      "type": "string"
                    },
                    "pendingTasksKnown": {
                      "type": "boolean"
                    },
                    "diagnosticNotes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "agent": {
                      "type": "object",
                      "properties": {
                        "recorded": {
                          "type": "boolean"
                        },
                        "agentVersion": {
                          "type": "string"
                        },
                        "capabilities": {
                          "type": "array",
                          "maxItems": 32,
                          "items": {
                            "type": "string"
                          }
                        },
                        "observedAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "certificateExpiresAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "history": {
                          "type": "array",
                          "maxItems": 100,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "at": {
                                "type": "string",
                                "format": "date-time"
                              },
                              "code": {
                                "type": "string",
                                "enum": [
                                  "authenticated",
                                  "disconnected"
                                ]
                              }
                            },
                            "required": [
                              "at",
                              "code"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
