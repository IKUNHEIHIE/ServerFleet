{
  "openapi": "3.1.0",
  "info": {
    "title": "Server Fleet identity and operational repairs R37 candidate",
    "version": "0.9.37-candidate",
    "description": "Additive HTTP revision. Existing G2/Proto/ADR inputs remain unchanged; not a G2 freeze. Identity renewals are control-plane lifecycle operations, never arbitrary task execution."
  },
  "servers": [
    {
      "url": "https://server-fleet.example.invalid"
    }
  ],
  "paths": {
    "/readyz": {
      "get": {
        "operationId": "readControllerReadinessR37",
        "summary": "Read configured subsystem readiness without exposing identities",
        "description": "Database, current runtime authority, task scheduler and configured Agent transport/issuer. No live nodes is not a failure.",
        "tags": [
          "IdentityOperationsR37"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ready",
                        "not_ready"
                      ]
                    },
                    "checks": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string",
                        "enum": [
                          "ready",
                          "unavailable",
                          "not_configured"
                        ]
                      }
                    }
                  },
                  "required": [
                    "status",
                    "checks"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Not ready or controller quarantined",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "ready",
                            "not_ready"
                          ]
                        },
                        "checks": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string",
                            "enum": [
                              "ready",
                              "unavailable",
                              "not_configured"
                            ]
                          }
                        }
                      },
                      "required": [
                        "status",
                        "checks"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agent/identity/renew": {
      "post": {
        "operationId": "renewAgentIdentityR37",
        "summary": "Renew current unexpired Agent identity over direct mutual TLS",
        "description": "TLS1.3 end-to-end; exact configured authority/SNI; no Cookie, Origin or Authorization. Same CSR public key and current node/generation; service gates rechecked. Inactive/revoked/expired identities cannot renew. New leaf activation retires the prior leaf after a two-minute overlap; no UNKNOWN task replay.",
        "tags": [
          "IdentityOperationsR37"
        ],
        "security": [
          {
            "agentMTLS": []
          }
        ],
        "responses": {
          "200": {
            "description": "Same successor certificate for the same old fingerprint/request/CSR",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "state": {
                      "type": "string",
                      "const": "issued"
                    },
                    "nodeId": {
                      "type": "string"
                    },
                    "certificatePem": {
                      "type": "string"
                    },
                    "intermediateChainPem": {
                      "type": "string"
                    },
                    "trustGeneration": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "state",
                    "nodeId",
                    "certificatePem",
                    "intermediateChainPem",
                    "trustGeneration",
                    "expiresAt"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Fixed sanitized problem code; preserves existing identity/tasks.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    },
                    "requestId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Fixed sanitized problem code; preserves existing identity/tasks.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    },
                    "requestId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Fixed sanitized problem code; preserves existing identity/tasks.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    },
                    "requestId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "requestId": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "csrPem": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16384
                  }
                },
                "required": [
                  "requestId",
                  "csrPem"
                ]
              }
            }
          }
        }
      }
    },
    "/api/v1/node-enrollment-tokens": {
      "post": {
        "operationId": "issueNodeEnrollmentTokenR37",
        "summary": "Issue a one-time enrollment or explicitly authorized replacement token",
        "description": "TTL1-10 minutes, maxUses=1. replaceNodeId requires current administrator plus that node nodes.revoke grant; suspended/revoked nodes are not automatically reactivated. Token ID differs from Agent persistent enrollment request ID.",
