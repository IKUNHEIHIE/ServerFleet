          },
          "201": {
            "description": "Token shown once",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "expiryMinutes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10,
                    "default": 10
                  },
                  "maxUses": {
                    "type": "integer",
                    "const": 1,
                    "default": 1
                  },
                  "replaceNodeId": {
                    "type": "string",
                    "maxLength": 128
                  }
                },
                "required": []
              }
            }
          }
        }
      }
    },
    "/api/v1/node-enrollments/{enrollmentId}/decision": {
      "post": {
        "operationId": "decideEnrollmentWithReadGrantR37",
        "summary": "Approve or reject enrollment with an explicit optional node read grant",
        "description": "grantRead defaults false for backward compatibility. When explicitly true, existing authorization service grants only this node nodes.read to the current administrator. A partially completed approval returns ENROLLMENT_APPROVED_READ_GRANT_PENDING; retry the same approved request. Revoked grants are not resurrected.",
        "tags": [
          "IdentityOperationsR37"
        ],
        "security": [
          {
            "cookieSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Approved/rejected enrollment view",
            "content": {
              "application/json": {
                "schema": {
