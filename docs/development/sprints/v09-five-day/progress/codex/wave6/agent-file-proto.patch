+
+// WAVE6 PROPOSED: only after files.chunk.v1 negotiation and a durable,
+// currently authorized TaskOffer reservation. Binding path/direction/size/hash
+// come from the immutable task parameters, never from these chunk requests.
+// Each frame remains one bounded Envelope; data <=32768, frame <=65536.
+message FileChunkRequest {
+  string task_id = 1;
+  string execution_id = 2;
+  string transfer_id = 3;
+  uint64 offset = 4;
+  uint32 read_bytes = 5; // read only, 1..32768
+  bytes data = 6;       // write only; never TaskOutput
+  bool finish = 7;      // write commit, whole-file hash must match plan
+}
+message FileChunkReply {
+  string task_id = 1;
+  string execution_id = 2;
+  string transfer_id = 3;
+  uint64 offset = 4;
+  uint64 next_offset = 5;
+  bytes data = 6; // read only
+  bool complete = 7;
+  string result_code = 8; // bounded enum vocabulary, no paths/secrets/errors
+}
